{
  "name": "c4-architecture-viewer",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-model.mjs",
    "predev": "node scripts/sync-model.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-model.mjs",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_AI_BRIDGE=0 vite build",
    "pages:deploy": "pnpm build:static && wrangler pages deploy dist --project-name=structurizer-yef --branch=main",
    "pages:dev": "wrangler pages dev dist",
    "dump": "node scripts/dump-mermaid.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/start.mjs",
    "audit:views": "node scripts/audit-views.mjs",
    "verify:render": "node scripts/render-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "codemirror": "^6.0.2",
    "jose": "^6.2.12",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0",
    "ws": "^8.21.3"
  }
}
